// Allow Docker stable updates for docker-ce, containerd.io, and compose plugin.
// Apt Origin is "Docker" (not "Docker CE"); archive is the Ubuntu codename (e.g. noble).
// Verify with: apt-cache policy containerd.io | grep -E 'o=|a='
// Reboots are handled by mattermost-reboot.timer (Sunday 04:00 UTC), not apt.
Unattended-Upgrade::Allowed-Origins {
    "${distro_id}:${distro_codename}";
    "${distro_id}:${distro_codename}-security";
    "${distro_id}ESMApps:${distro_codename}-apps-security";
    "${distro_id}ESM:${distro_codename}-infra-security";
    "Docker:${distro_codename}";
    "Docker:stable";
};
