MM_VERSION=11.8.2
# Optional: set to verify the official Mattermost ARM64 release tarball during image build.
# MM_TARBALL_SHA256=

PROD_HOSTNAME=chat.example.com
TEST_HOSTNAME=chat-test.example.com
TEST_ALLOWED_CIDR=198.51.100.10/32

POSTGRES_SUPER_PASSWORD=replace-with-random-hex

MM_PROD_DB_NAME=mattermost_prod
MM_PROD_DB_USER=mattermost_prod
MM_PROD_DB_PASSWORD=replace-with-random-hex

MM_TEST_DB_NAME=mattermost_test
MM_TEST_DB_USER=mattermost_test
MM_TEST_DB_PASSWORD=replace-with-random-hex

BACKUP_BUCKET_NAME=mattermost-backups
LOCAL_BACKUP_RETENTION_DAYS=7

# Filestore: Mattermost → local rclone S3 proxy → private OCI bucket (instance principal).
# Prefer scripts/render-env.sh after tofu apply.
OBJECT_STORAGE_NAMESPACE=yournamespace
COMPARTMENT_OCID=ocid1.compartment.oc1..example
MM_FILESETTINGS_DRIVERNAME=amazons3
MM_FILESETTINGS_MAXFILESIZE=52428800
MM_FILESETTINGS_ENABLEFILEATTACHMENTS=true
MM_FILESETTINGS_AMAZONS3BUCKET=mattermost-files
MM_FILESETTINGS_AMAZONS3ENDPOINT=filestore-s3:9000
MM_FILESETTINGS_AMAZONS3REGION=us-phoenix-1
MM_FILESETTINGS_AMAZONS3ACCESSKEYID=replace-with-local-proxy-access-key
MM_FILESETTINGS_AMAZONS3SECRETACCESSKEY=replace-with-local-proxy-secret-key
MM_FILESETTINGS_AMAZONS3SSL=false
MM_FILESETTINGS_AMAZONS3SSE=false

MM_CALLS_UDP_SERVER_ADDRESS=0.0.0.0
MM_CALLS_UDP_SERVER_PORT=8443
MM_CALLS_ICE_HOST_OVERRIDE=chat.example.com

# Mobile push (Mattermost Hosted Push Notification Service).
MM_PUSH_NOTIFICATION_SERVER=https://global.push.mattermost.com

# Optional: Mattermost incoming webhook for ops alerts (JSON {"text":"..."}).
# Create in Mattermost: Integrations → Incoming Webhooks → copy URL ending in /hooks/...
# Use the webhook URL, not the channel URL (https://chat.example.com/team/channels/foo).
# Set on the VM in /opt/mattermost/.env, then re-run render-env or edit in place.
# Without this, failures appear only in: journalctl -u mattermost-backup.service / mattermost-health.service
# ALERT_WEBHOOK_URL=https://chat.example.com/hooks/xxxxxxxxxxxxxxxxxx

# Optional: webhook when Sunday maintenance completes successfully (reboot, Caddy, post-maintenance summary).
# Requires ALERT_WEBHOOK_URL. Does not replace problem alerts from check-updates.sh.
# ALERT_WEBHOOK_MAINTENANCE=true
